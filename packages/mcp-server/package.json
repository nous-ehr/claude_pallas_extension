{
  "name": "@pallas/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.cjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "minisearch": "^7.1.0",
    "zod": "^3.23.8",
    "express": "^4.21.0",
    "@azure/cosmos": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.5"
  }
}
